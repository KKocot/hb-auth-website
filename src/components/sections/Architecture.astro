---
// Architecture section — security isolation diagram
---

<section id="architecture" class="relative px-6 py-24 md:py-32 overflow-hidden">
  <!-- Background glow -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_50%,rgba(0,230,197,0.04),transparent)]" />
  </div>

  <!-- Header -->
  <div class="arch-reveal mx-auto max-w-[75rem] text-center mb-16">
    <h2 class="text-3xl font-bold text-text md:text-5xl mb-4">Security by isolation</h2>
    <p class="mx-auto max-w-2xl text-text-muted text-lg">
      Private keys are processed inside a WebWorker — completely isolated from your application code.
    </p>
  </div>

  <!-- Diagram -->
  <div class="arch-reveal [animation-delay:150ms] mx-auto max-w-[75rem]">
    <div class="arch-diagram grid grid-cols-1 items-center gap-8 md:grid-cols-[1fr_auto_1fr]">

      <!-- Main Thread Box -->
      <div class="rounded-xl border border-border bg-bg-card p-6 md:p-8">
        <div class="mb-4 flex items-center gap-2">
          <svg class="h-5 w-5 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
          <span class="font-mono text-sm font-semibold text-text">Main Thread</span>
        </div>
        <ul class="space-y-2">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="font-mono text-sm text-text-muted">OnlineClient</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="font-mono text-sm text-text-muted">OfflineClient</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-text-muted shrink-0"></span>
            <span class="font-mono text-sm text-text-muted">HBAuthProvider</span>
          </li>
        </ul>
      </div>

      <!-- Connection line (center column) -->
      <div class="flex flex-col items-center gap-2">
        <!-- Vertical arrow on mobile, horizontal on desktop -->
        <svg
          class="arch-connection hidden md:block"
          width="120"
          height="40"
          viewBox="0 0 120 40"
          fill="none"
          role="img"
          aria-label="Bidirectional Comlink RPC connection between Main Thread and WebWorker"
        >
          <!-- Dashed line -->
          <line x1="0" y1="20" x2="120" y2="20" stroke="rgba(0,230,197,0.4)" stroke-width="2" stroke-dasharray="6 4" class="arch-dash" />
          <!-- Arrowhead left -->
          <polyline points="8,14 0,20 8,26" fill="none" stroke="rgba(0,230,197,0.6)" stroke-width="2" />
          <!-- Arrowhead right -->
          <polyline points="112,14 120,20 112,26" fill="none" stroke="rgba(0,230,197,0.6)" stroke-width="2" />
        </svg>
        <!-- Mobile vertical arrow -->
        <svg
          class="arch-connection md:hidden"
          width="40"
          height="80"
          viewBox="0 0 40 80"
          fill="none"
          role="img"
          aria-label="Bidirectional Comlink RPC connection between Main Thread and WebWorker"
        >
          <line x1="20" y1="0" x2="20" y2="80" stroke="rgba(0,230,197,0.4)" stroke-width="2" stroke-dasharray="6 4" class="arch-dash-v" />
          <polyline points="14,8 20,0 26,8" fill="none" stroke="rgba(0,230,197,0.6)" stroke-width="2" />
          <polyline points="14,72 20,80 26,72" fill="none" stroke="rgba(0,230,197,0.6)" stroke-width="2" />
        </svg>
        <span class="font-mono text-xs text-accent">Comlink RPC</span>
      </div>

      <!-- WebWorker Box (vault) -->
      <div class="arch-vault rounded-xl border border-accent/50 bg-bg-card p-6 md:p-8 relative">
        <!-- Glow overlay -->
        <div class="pointer-events-none absolute inset-0 rounded-xl" aria-hidden="true"
          style="box-shadow: 0 0 30px rgba(0,230,197,0.08), inset 0 0 30px rgba(0,230,197,0.03);"
        ></div>

        <div class="relative">
          <div class="mb-4 flex items-center gap-2">
            <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              <circle cx="12" cy="16" r="1" />
            </svg>
            <span class="font-mono text-sm font-semibold text-accent">WebWorker / SharedWorker</span>
          </div>

          <!-- AuthWorker label -->
          <p class="font-mono text-xs text-text-muted mb-3">AuthWorker</p>

          <!-- Inner boxes -->
          <div class="space-y-3">
            <!-- Beekeeper WASM -->
            <div class="rounded-lg border border-accent/30 bg-accent/5 p-4">
              <div class="flex items-center gap-2 mb-1">
                <svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M12 2L3 7l9 5 9-5-9-5z" />
                  <path d="M3 17l9 5 9-5" />
                  <path d="M3 12l9 5 9-5" />
                </svg>
                <span class="font-mono text-sm font-semibold text-accent">Beekeeper (WASM)</span>
              </div>
              <p class="font-mono text-xs text-text-muted flex items-center gap-1.5">
                <svg class="h-3.5 w-3.5 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Private Keys
              </p>
            </div>

            <!-- IndexedDB -->
            <div class="rounded-lg border border-border bg-bg/50 p-4">
              <div class="flex items-center gap-2 mb-1">
                <svg class="h-4 w-4 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <ellipse cx="12" cy="5" rx="9" ry="3" />
                  <path d="M21 12c0 1.66-4.03 3-9 3s-9-1.34-9-3" />
                  <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5" />
                </svg>
                <span class="font-mono text-sm text-text-muted">IndexedDB</span>
              </div>
              <p class="font-mono text-xs text-text-muted">Encrypted Store</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SharedWorker tabs indicator -->
    <div class="arch-reveal [animation-delay:300ms] mt-8 flex justify-center md:justify-end">
      <div class="flex items-center gap-3 rounded-lg border border-border bg-bg-card px-4 py-3">
        <svg class="h-4 w-4 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8M12 17v4" />
        </svg>
        <svg class="h-4 w-4 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8M12 17v4" />
        </svg>
        <svg class="h-4 w-4 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2" />
          <path d="M8 21h8M12 17v4" />
        </svg>
        <span class="font-mono text-xs text-text-muted">SharedWorker syncs across tabs</span>
      </div>
    </div>
  </div>

</section>

<style>
  /* Scroll-triggered fade-in */
  .arch-reveal {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  .arch-reveal.is-visible {
    animation: arch-fade-in 0.6s ease-out forwards;
  }

  @keyframes arch-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animated dash offset on connection lines */
  .arch-dash {
    animation: dash-flow 1.5s linear infinite;
  }

  .arch-dash-v {
    animation: dash-flow-v 1.5s linear infinite;
  }

  @keyframes dash-flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  @keyframes dash-flow-v {
    to {
      stroke-dashoffset: -20;
    }
  }

  /* Vault glow pulse */
  .arch-vault {
    animation: vault-glow 3s ease-in-out infinite;
  }

  @keyframes vault-glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(0, 230, 197, 0.06);
    }
    50% {
      box-shadow: 0 0 35px rgba(0, 230, 197, 0.12);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .arch-reveal {
      opacity: 1;
      transform: none;
    }

    .arch-reveal.is-visible {
      animation-duration: 0.01ms;
    }

    .arch-dash,
    .arch-dash-v {
      animation-duration: 0.01ms;
    }

    .arch-vault {
      animation-duration: 0.01ms;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.arch-reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  reveals.forEach((el) => observer.observe(el));
</script>

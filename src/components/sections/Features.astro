---
import { Code } from 'astro:components';

const waxCode = `import { HBAuthProvider } from '@hiveio/signers-hb-auth';
// Full TypeScript definitions & autocomplete

const signer: IOnlineSignerProvider =
  HBAuthProvider.for(
    client, 'username', 'posting'
  );

// Type-safe transaction building
const tx = await chain.createTransaction();
tx.pushOperation({ vote: { ... } });
await tx.sign(signer); // Keys never leave Worker`;

const terminalLines = [
  { text: '> MainThread: request sign(tx)', accent: false },
  { text: '> Comlink RPC  -->  WebWorker', accent: 'arrows' },
  { text: '> Beekeeper:       decrypt(key)', accent: false },
  { text: '> Beekeeper:       sign(tx)', accent: false },
  { text: '> Comlink RPC  <--  signed_tx', accent: 'arrows' },
  { text: '> MainThread: broadcast(signed_tx)', accent: false },
  { text: '> [key never crossed the boundary]', accent: 'full' },
];
---

<section id="features" class="relative py-24 px-6 md:py-32 overflow-hidden">
  {/* Background radial glow */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_40%_at_50%_50%,rgba(0,230,197,0.04),transparent)]" />
  </div>

  <div class="relative mx-auto max-w-[75rem]">
    {/* Section header */}
    <div class="feat-reveal mx-auto mb-16 max-w-3xl text-center">
      <h2 class="text-3xl font-bold md:text-5xl text-text">
        Built for security-first applications
      </h2>
      <p class="mt-4 text-lg text-text-muted">
        Enterprise-grade authentication primitives that keep private keys where they belong — on the user's device.
      </p>
    </div>

    {/* Bento grid */}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-5">

      {/* === Card 1: Zero Key Exposure — hero card === */}
      <div
        class="feature-card hero-card feat-card-hover col-span-1 md:col-span-7 rounded-xl border border-accent/40 bg-bg-card p-6 md:p-8 relative opacity-0"
        style="--stagger-delay: 0ms; --translate-y: 24px; box-shadow: 0 0 30px rgba(0,230,197,0.08);"
      >
        <div class="flex items-center gap-3 mb-4">
          <svg class="h-6 w-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            <circle cx="12" cy="16" r="1" />
          </svg>
          <h3 class="text-xl font-semibold text-text">Zero Key Exposure</h3>
        </div>
        <p class="text-sm leading-relaxed text-text-muted mb-6 max-w-lg">
          The core security model. Private keys never leave the WebWorker — encrypted by Beekeeper WASM, fully isolated from main thread. Your app cannot access them.
        </p>
        <div class="overflow-hidden rounded-lg border border-border">
          <div class="flex items-center gap-2 border-b border-border bg-[#111] px-4 py-2.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57] opacity-60" />
            <span class="h-3 w-3 rounded-full bg-[#febc2e] opacity-60" />
            <span class="h-3 w-3 rounded-full bg-[#28c840] opacity-60" />
            <span class="ml-3 font-mono text-xs text-text-muted">
              security-flow.log
            </span>
          </div>
          <div class="bg-[#111] p-4 md:p-5 min-h-[12rem]">
            <pre
              id="terminal-output"
              class="font-mono text-xs leading-relaxed text-text-muted"
              aria-label="Security flow terminal output showing that private keys never cross the WebWorker boundary"
              data-terminal-lines={JSON.stringify(terminalLines)}
            >{/* Lines rendered by JS typing animation */}<noscript>{terminalLines.map((line) => (
                <span class={line.accent === 'full' ? 'text-accent' : ''}>
                  {line.text}{'\n'}
                </span>
              ))}</noscript></pre>
          </div>
        </div>
      </div>

      {/* === Card 2: Wax SDK + TypeScript (merged) === */}
      <div
        class="feature-card feat-card-hover col-span-1 md:col-span-5 rounded-xl border border-border bg-bg-card p-6 md:p-8 opacity-0"
        style="--stagger-delay: 120ms; --translate-y: 24px"
      >
        <div class="flex items-center gap-3 mb-1">
          <svg class="h-6 w-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          <h3 class="text-xl font-semibold text-text">Wax SDK + TypeScript</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-text-muted mb-6">
          Drop-in signer provider for @hiveio/wax with strict types and full autocomplete out of the box.
        </p>
        <div class="overflow-hidden rounded-lg border border-border">
          <div class="flex items-center gap-2 border-b border-border bg-[#111] px-4 py-2.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57] opacity-60" />
            <span class="h-3 w-3 rounded-full bg-[#febc2e] opacity-60" />
            <span class="h-3 w-3 rounded-full bg-[#28c840] opacity-60" />
            <span class="ml-3 font-mono text-xs text-text-muted">signer.ts</span>
          </div>
          <div class="bg-[#111] p-4 text-sm [&_pre]:!bg-transparent [&_pre]:!p-0 [&_pre]:!m-0 [&_code]:!text-sm">
            <Code code={waxCode} lang="typescript" theme="github-dark" />
          </div>
        </div>
      </div>

      {/* === Card 3: Session-Based Auth === */}
      <div
        class="feature-card feat-card-hover col-span-1 md:col-span-4 rounded-xl border border-border bg-bg-card p-6 md:p-8 opacity-0"
        style="--stagger-delay: 220ms; --translate-y: 24px"
      >
        <div class="flex items-center gap-3 mb-4">
          <svg class="h-6 w-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <h3 class="text-xl font-semibold text-text">Session-Based Auth</h3>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          One session synced across all tabs via SharedWorker. Survives page refresh. No repeated logins.
        </p>
      </div>

      {/* === Card 4: Role-Based Access === */}
      <div
        class="feature-card feat-card-hover col-span-1 md:col-span-4 rounded-xl border border-border bg-bg-card p-6 md:p-8 opacity-0"
        style="--stagger-delay: 320ms; --translate-y: 24px"
      >
        <div class="flex items-center gap-3 mb-4">
          <svg class="h-6 w-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
          <h3 class="text-xl font-semibold text-text">Role-Based Access</h3>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Granular key roles — posting, active, owner. Each operation uses the minimum authority required.
        </p>
      </div>

      {/* === Card 5: Built for Hive === */}
      <div
        class="feature-card feat-card-hover col-span-1 md:col-span-4 rounded-xl border border-border bg-bg-card p-6 md:p-8 opacity-0"
        style="--stagger-delay: 420ms; --translate-y: 24px"
      >
        <div class="flex items-center gap-3 mb-4">
          <svg class="h-6 w-6 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2l5.196 3v6L12 14 6.804 11V5z" />
            <path d="M12 14v8" />
            <path d="M6.804 11L2 13.5V19l4.804 3L12 19" />
            <path d="M17.196 11L22 13.5V19l-4.804 3L12 19" />
          </svg>
          <h3 class="text-xl font-semibold text-text">Built for Hive</h3>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Native Hive blockchain integration. On-chain verification when connected, local-only mode when offline.
        </p>
      </div>

    </div>
  </div>
</section>

<style>
  /* === Scroll-triggered reveal (consistent with Architecture .arch-reveal) === */
  .feat-reveal {
    opacity: 0;
    transform: translateY(1.5rem);
  }

  .feat-reveal.is-visible {
    animation: feat-fade-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @keyframes feat-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* === Card scroll animation (kept for script compatibility) === */
  :global(.feature-card) {
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--stagger-delay, 0ms);
    transform: translateY(var(--translate-y, 24px));
  }

  :global(.feature-card.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* === Card hover effects === */
  .feat-card-hover {
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .feat-card-hover:hover {
    border-color: rgba(0, 230, 197, 0.3);
    box-shadow: 0 0 20px rgba(0, 230, 197, 0.05);
  }

  /* Hero card keeps its stronger glow on hover */
  .hero-card.feat-card-hover:hover {
    border-color: rgba(0, 230, 197, 0.5);
    box-shadow: 0 0 40px rgba(0, 230, 197, 0.1);
  }

  /* === prefers-reduced-motion === */
  @media (prefers-reduced-motion: reduce) {
    .feat-reveal {
      opacity: 1;
      transform: none;
    }

    .feat-reveal.is-visible {
      animation-duration: 0.01ms;
    }

    :global(.feature-card) {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .feat-card-hover {
      transition: none;
    }
  }
</style>

<script>
  // === IntersectionObserver for scroll animations ===
  const featureObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          featureObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -30px 0px' }
  );

  document.querySelectorAll('.feature-card').forEach((card) => {
    featureObserver.observe(card);
  });

  // === IntersectionObserver for .feat-reveal elements (header, etc.) ===
  const featRevealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          featRevealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('.feat-reveal:not(.feature-card)').forEach((el) => {
    featRevealObserver.observe(el);
  });

  // === Terminal typing animation ===
  const terminalEl = document.getElementById('terminal-output');

  const terminalLines: Array<{ text: string; accent: string | false }> = terminalEl
    ? JSON.parse(terminalEl.dataset.terminalLines ?? '[]')
    : [];

  const CHAR_DELAY = 40;
  const LINE_PAUSE = 200;
  const INITIAL_DELAY = 800;

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  function renderStaticTerminal() {
    if (!terminalEl) return;
    terminalEl.replaceChildren();
    terminalLines.forEach((line) => {
      const span = document.createElement('span');
      if (line.accent === 'full') {
        span.className = 'text-accent';
        span.textContent = line.text + '\n';
      } else if (line.accent === 'arrows') {
        // Highlight arrows within the line
        const parts = line.text.split(/(-->|<--)/);
        parts.forEach((part) => {
          if (part === '-->' || part === '<--') {
            const accentSpan = document.createElement('span');
            accentSpan.className = 'text-accent';
            accentSpan.textContent = part;
            span.appendChild(accentSpan);
          } else {
            span.appendChild(document.createTextNode(part));
          }
        });
        span.appendChild(document.createTextNode('\n'));
      } else {
        span.textContent = line.text + '\n';
      }
      terminalEl.appendChild(span);
    });
  }

  // Collect all timeout IDs for cleanup
  const timeoutIds: number[] = [];

  // Cleanup on Astro View Transitions navigation
  document.addEventListener('astro:before-preparation', () => {
    timeoutIds.forEach(clearTimeout);
  });

  if (prefersReducedMotion) {
    renderStaticTerminal();
  } else {
    // Typing animation triggered on viewport entry
    let animationStarted = false;

    const heroCard = document.querySelector('.hero-card');
    if (heroCard && terminalEl) {
      const terminalObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !animationStarted) {
              animationStarted = true;
              terminalObserver.unobserve(entry.target);
              timeoutIds.push(setTimeout(() => startTypingAnimation(), INITIAL_DELAY));
            }
          });
        },
        { threshold: 0.3 }
      );
      terminalObserver.observe(heroCard);
    }

    function startTypingAnimation() {
      if (!terminalEl) return;
      terminalEl.replaceChildren();

      let totalDelay = 0;

      terminalLines.forEach((line, lineIndex) => {
        const lineDelay = totalDelay;

        // Schedule character-by-character typing for this line
        const chars = line.text.split('');
        let lineSpan: HTMLSpanElement | null = null;

        chars.forEach((char, charIndex) => {
          timeoutIds.push(setTimeout(() => {
            if (!terminalEl?.isConnected) return;

            if (!lineSpan) {
              lineSpan = document.createElement('span');
              if (line.accent === 'full') {
                lineSpan.className = 'text-accent';
              }
              terminalEl.appendChild(lineSpan);
            }

            // For arrow lines, handle accent coloring of arrows
            if (line.accent === 'arrows') {
              const textSoFar = line.text.substring(0, charIndex + 1);
              // Clear and re-render with accent spans
              lineSpan.replaceChildren();
              const parts = textSoFar.split(/(-->|<--)/);
              parts.forEach((part) => {
                if (!lineSpan) return;
                if (part === '-->' || part === '<--') {
                  const accentSpan = document.createElement('span');
                  accentSpan.className = 'text-accent';
                  accentSpan.textContent = part;
                  lineSpan.appendChild(accentSpan);
                } else if (part === '-' || part === '->' || part === '<' || part === '<-') {
                  // Partial arrow — render as normal text
                  lineSpan.appendChild(document.createTextNode(part));
                } else {
                  lineSpan.appendChild(document.createTextNode(part));
                }
              });
            } else {
              lineSpan.textContent = line.text.substring(0, charIndex + 1);
            }
          }, lineDelay + charIndex * CHAR_DELAY));
        });

        totalDelay += chars.length * CHAR_DELAY + LINE_PAUSE;

        // Add newline after this line finishes
        timeoutIds.push(setTimeout(() => {
          if (!terminalEl?.isConnected) return;
          if (lineSpan) {
            lineSpan.appendChild(document.createTextNode('\n'));
          }
          // After last line, mark as complete (for accessibility)
          if (lineIndex === terminalLines.length - 1 && terminalEl) {
            terminalEl.setAttribute('data-animation-complete', 'true');
          }
        }, lineDelay + chars.length * CHAR_DELAY));
      });
    }
  }
</script>

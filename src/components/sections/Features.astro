---
import { Code } from 'astro:components';
import Card from '../ui/Card.astro';

const waxCode = `import { HBAuthProvider } from '@hiveio/signers-hb-auth';

const signer = HBAuthProvider.for(
  client, 'username', 'posting'
);
// One line. Full signing capability.`;

const tsCode = `interface OnlineClient {
  initialize(chain: IHiveChainInterface): Promise<void>;
  register(
    username: string,
    password: string,
    wifKey:   string,
    role:     'posting' | 'active' | 'owner'
  ): Promise<boolean>;
  authenticate(
    username: string,
    password: string,
    role:     'posting' | 'active' | 'owner'
  ): Promise<boolean>;
}`;

const terminalLines = [
  { text: '> MainThread: request sign(tx)', accent: false },
  { text: '> Comlink RPC  -->  WebWorker', accent: 'arrows' },
  { text: '> Beekeeper:       decrypt(key)', accent: false },
  { text: '> Beekeeper:       sign(tx)', accent: false },
  { text: '> Comlink RPC  <--  signed_tx', accent: 'arrows' },
  { text: '> MainThread: broadcast(signed_tx)', accent: false },
  { text: '> [key never crossed the boundary]', accent: 'full' },
];

const smallCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 7h2a5 5 0 0 1 0 10h-2m-6 0H7A5 5 0 0 1 7 7h2"/><line x1="8" x2="16" y1="12" y2="12"/></svg>`,
    title: 'SharedWorker Sync',
    description: 'One session, all tabs. Survives refresh.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/><circle cx="7" cy="7" r="1.5" fill="#4EBF71" stroke="none"/><circle cx="17" cy="7" r="1.5" fill="#febc2e" stroke="none"/></svg>`,
    title: 'Online & Offline',
    description: 'On-chain verification or local-only mode.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 10a2 2 0 0 0-2 2c0 1.02.76 1.85 1.75 1.97V16h.5v-2.03A2.001 2.001 0 0 0 12 10z"/><path d="M4 16V8a8 8 0 1 1 16 0v8"/><path d="M18 12a6 6 0 0 0-12 0"/><path d="M2 16h20"/></svg>`,
    title: 'Passkey & Biometric',
    description: 'WebAuthn PRF. Fingerprint or face to unlock.',
  },
];
---

<section id="features" class="py-24 px-6">
  <div class="mx-auto max-w-6xl">
    {/* Section header */}
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <span class="mb-4 inline-block font-mono text-sm tracking-widest text-accent uppercase">
        FEATURES
      </span>
      <h2 class="text-3xl font-bold md:text-5xl text-text">
        Built for security-first applications
      </h2>
    </div>

    {/* Bento grid */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      {/* === HERO CARD: Zero Key Exposure === */}
      <div
        class="feature-card hero-card relative col-span-1 lg:col-span-2 overflow-hidden rounded-xl border border-accent/30 bg-bg-card p-8 md:p-10 opacity-0"
        style="--stagger-delay: 0ms; --translate-y: 24px"
      >
        {/* Border beam pseudo-element overlay */}
        <div class="beam-container" aria-hidden="true"></div>

        {/* Radial gradient background */}
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_80%_50%,rgba(0,230,197,0.04),transparent)]"
          aria-hidden="true"
        />

        <div class="relative flex flex-col lg:flex-row gap-8 lg:gap-10">
          {/* Left: Text content */}
          <div class="flex flex-col justify-center lg:w-1/2">
            <span class="mb-4 inline-flex w-fit items-center rounded-full border border-accent/20 bg-accent/10 px-3 py-1 font-mono text-xs text-accent uppercase">
              CORE SECURITY MODEL
            </span>
            <h3 class="mb-3 text-2xl font-bold md:text-3xl text-text">
              Zero Key Exposure
            </h3>
            <p class="text-sm leading-relaxed text-text-muted md:text-base">
              Private keys never leave the WebWorker. Encrypted by Beekeeper WASM, isolated from main thread JavaScript. Your app literally cannot access them.
            </p>
          </div>

          {/* Right: Terminal */}
          <div class="lg:w-1/2">
            <div class="overflow-hidden rounded-lg border border-border">
              {/* Tab bar */}
              <div class="flex items-center gap-2 border-b border-border bg-[#111] px-4 py-2.5">
                <span class="h-3 w-3 rounded-full bg-[#ff5f57] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#febc2e] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#28c840] opacity-60" />
                <span class="ml-3 font-mono text-xs text-text-muted">
                  security-flow.log
                </span>
              </div>
              {/* Terminal content */}
              <div class="bg-[#111] p-4 md:p-5 min-h-[12rem]">
                <pre
                  id="terminal-output"
                  class="font-mono text-xs leading-relaxed text-text-muted"
                  aria-label="Security flow terminal output showing that private keys never cross the WebWorker boundary"
                  data-terminal-lines={JSON.stringify(terminalLines)}
                >{/* Lines rendered by JS typing animation */}<noscript>{terminalLines.map((line) => (
                    <span class={line.accent === 'full' ? 'text-accent' : ''}>
                      {line.text}{'\n'}
                    </span>
                  ))}</noscript></pre>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* === MEDIUM LEFT: Wax SDK Integration === */}
      <div
        class="feature-card opacity-0"
        style="--stagger-delay: 150ms; --translate-y: 24px"
      >
        <Card interactive>
          <div class="flex flex-col h-full">
            <span class="mb-3 font-mono text-xs text-accent">Drop-in signer</span>
            <h3 class="mb-4 text-lg font-semibold text-text">Wax SDK Integration</h3>
            <div class="overflow-hidden rounded-lg border border-border">
              <div class="flex items-center gap-2 border-b border-border bg-[#111] px-4 py-2.5">
                <span class="h-3 w-3 rounded-full bg-[#ff5f57] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#febc2e] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#28c840] opacity-60" />
                <span class="ml-3 font-mono text-xs text-text-muted">signer.ts</span>
              </div>
              <div class="bg-[#111] p-4 text-sm [&_pre]:!bg-transparent [&_pre]:!p-0 [&_pre]:!m-0 [&_code]:!text-sm">
                <Code code={waxCode} lang="typescript" theme="github-dark" />
              </div>
            </div>
            <p class="mt-3 text-xs text-text-muted">
              Compatible with @hiveio/wax transaction builder
            </p>
          </div>
        </Card>
      </div>

      {/* === MEDIUM RIGHT: TypeScript First === */}
      <div
        class="feature-card opacity-0"
        style="--stagger-delay: 250ms; --translate-y: 24px"
      >
        <Card interactive>
          <div class="flex flex-col h-full">
            <span class="mb-3 font-mono text-xs text-accent">Strict types</span>
            <h3 class="mb-4 text-lg font-semibold text-text">TypeScript First</h3>
            <div class="overflow-hidden rounded-lg border border-border">
              <div class="flex items-center gap-2 border-b border-border bg-[#111] px-4 py-2.5">
                <span class="h-3 w-3 rounded-full bg-[#ff5f57] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#febc2e] opacity-60" />
                <span class="h-3 w-3 rounded-full bg-[#28c840] opacity-60" />
                <span class="ml-3 font-mono text-xs text-text-muted">types.d.ts</span>
              </div>
              <div class="bg-[#111] p-4 text-sm [&_pre]:!bg-transparent [&_pre]:!p-0 [&_pre]:!m-0 [&_code]:!text-sm">
                <Code code={tsCode} lang="typescript" theme="github-dark" />
              </div>
            </div>
            <p class="mt-3 text-xs text-text-muted">
              Full type definitions. Autocomplete out of the box.
            </p>
          </div>
        </Card>
      </div>

      {/* === SMALL CARDS ROW === */}
      <div class="col-span-1 lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-6">
        {smallCards.map((card, i) => (
          <div
            class="feature-card opacity-0"
            data-size="small"
            style={`--stagger-delay: ${400 + i * 50}ms; --translate-y: 16px`}
          >
            <Card interactive class="h-full !p-4 md:!p-5">
              <div class="mb-3 text-accent" set:html={card.icon} />
              <h3 class="mb-1 text-sm font-semibold text-text">{card.title}</h3>
              <p class="text-xs text-text-muted">{card.description}</p>
            </Card>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* === @property registration for beam angle === */
  @property --beam-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  /* === Border beam effect === */
  .hero-card {
    position: relative;
    isolation: isolate;
  }

  .beam-container {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .beam-container::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(
      from var(--beam-angle),
      transparent 80%,
      rgba(0, 230, 197, 0.6) 90%,
      transparent 100%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: beam-rotate 6s linear infinite;
  }

  @keyframes beam-rotate {
    to {
      --beam-angle: 360deg;
    }
  }

  /* === Scroll animation === */
  :global(.feature-card) {
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--stagger-delay, 0ms);
    transform: translateY(var(--translate-y, 24px));
  }

  :global(.feature-card.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Small cards get shorter duration */
  :global(.feature-card[data-size="small"]) {
    transition-duration: 0.5s;
  }

  /* === prefers-reduced-motion === */
  @media (prefers-reduced-motion: reduce) {
    :global(.feature-card) {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .beam-container::before {
      animation: none;
    }

    /* Terminal shows static text (handled in JS too) */
  }
</style>

<script>
  // === IntersectionObserver for scroll animations ===
  const featureObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          featureObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -30px 0px' }
  );

  document.querySelectorAll('.feature-card').forEach((card) => {
    featureObserver.observe(card);
  });

  // === Terminal typing animation ===
  const terminalEl = document.getElementById('terminal-output');

  const terminalLines: Array<{ text: string; accent: string | false }> = terminalEl
    ? JSON.parse(terminalEl.dataset.terminalLines ?? '[]')
    : [];

  const CHAR_DELAY = 40;
  const LINE_PAUSE = 200;
  const INITIAL_DELAY = 800;

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  function renderStaticTerminal() {
    if (!terminalEl) return;
    terminalEl.replaceChildren();
    terminalLines.forEach((line) => {
      const span = document.createElement('span');
      if (line.accent === 'full') {
        span.className = 'text-accent';
        span.textContent = line.text + '\n';
      } else if (line.accent === 'arrows') {
        // Highlight arrows within the line
        const parts = line.text.split(/(-->|<--)/);
        parts.forEach((part) => {
          if (part === '-->' || part === '<--') {
            const accentSpan = document.createElement('span');
            accentSpan.className = 'text-accent';
            accentSpan.textContent = part;
            span.appendChild(accentSpan);
          } else {
            span.appendChild(document.createTextNode(part));
          }
        });
        span.appendChild(document.createTextNode('\n'));
      } else {
        span.textContent = line.text + '\n';
      }
      terminalEl.appendChild(span);
    });
  }

  // Collect all timeout IDs for cleanup
  const timeoutIds: number[] = [];

  // Cleanup on Astro View Transitions navigation
  document.addEventListener('astro:before-preparation', () => {
    timeoutIds.forEach(clearTimeout);
  });

  if (prefersReducedMotion) {
    renderStaticTerminal();
  } else {
    // Typing animation triggered on viewport entry
    let animationStarted = false;

    const heroCard = document.querySelector('.hero-card');
    if (heroCard && terminalEl) {
      const terminalObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !animationStarted) {
              animationStarted = true;
              terminalObserver.unobserve(entry.target);
              timeoutIds.push(setTimeout(() => startTypingAnimation(), INITIAL_DELAY));
            }
          });
        },
        { threshold: 0.3 }
      );
      terminalObserver.observe(heroCard);
    }

    function startTypingAnimation() {
      if (!terminalEl) return;
      terminalEl.replaceChildren();

      let totalDelay = 0;

      terminalLines.forEach((line, lineIndex) => {
        const lineDelay = totalDelay;

        // Schedule character-by-character typing for this line
        const chars = line.text.split('');
        let lineSpan: HTMLSpanElement | null = null;

        chars.forEach((char, charIndex) => {
          timeoutIds.push(setTimeout(() => {
            if (!terminalEl?.isConnected) return;

            if (!lineSpan) {
              lineSpan = document.createElement('span');
              if (line.accent === 'full') {
                lineSpan.className = 'text-accent';
              }
              terminalEl.appendChild(lineSpan);
            }

            // For arrow lines, handle accent coloring of arrows
            if (line.accent === 'arrows') {
              const textSoFar = line.text.substring(0, charIndex + 1);
              // Clear and re-render with accent spans
              lineSpan.replaceChildren();
              const parts = textSoFar.split(/(-->|<--)/);
              parts.forEach((part) => {
                if (!lineSpan) return;
                if (part === '-->' || part === '<--') {
                  const accentSpan = document.createElement('span');
                  accentSpan.className = 'text-accent';
                  accentSpan.textContent = part;
                  lineSpan.appendChild(accentSpan);
                } else if (part === '-' || part === '->' || part === '<' || part === '<-') {
                  // Partial arrow — render as normal text
                  lineSpan.appendChild(document.createTextNode(part));
                } else {
                  lineSpan.appendChild(document.createTextNode(part));
                }
              });
            } else {
              lineSpan.textContent = line.text.substring(0, charIndex + 1);
            }
          }, lineDelay + charIndex * CHAR_DELAY));
        });

        totalDelay += chars.length * CHAR_DELAY + LINE_PAUSE;

        // Add newline after this line finishes
        timeoutIds.push(setTimeout(() => {
          if (!terminalEl?.isConnected) return;
          if (lineSpan) {
            lineSpan.appendChild(document.createTextNode('\n'));
          }
          // After last line, mark as complete (for accessibility)
          if (lineIndex === terminalLines.length - 1 && terminalEl) {
            terminalEl.setAttribute('data-animation-complete', 'true');
          }
        }, lineDelay + chars.length * CHAR_DELAY));
      });
    }
  }
</script>

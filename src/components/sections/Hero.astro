---
---

<section
  class="relative min-h-screen flex flex-col items-center justify-center px-6 pt-24 pb-16 text-center overflow-hidden"
>
  <!-- Background: radial gradient + grid pattern -->
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(0,230,197,0.08),transparent)]" />
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 64px 64px;"
    />

    <!-- Animated SVG background elements -->
    <div class="hero-animated-bg pointer-events-none absolute inset-0" aria-hidden="true">
      <!-- Hexagon 1 -->
      <svg
        class="absolute w-[120px] md:w-[180px]"
        style="top:8%;left:5%;opacity:0.07;filter:blur(1px);will-change:transform;animation:hex-float-1 18s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.07)" stroke-width="1" />
      </svg>

      <!-- Hexagon 2 -->
      <svg
        class="absolute w-[80px] md:w-[120px]"
        style="top:15%;left:85%;opacity:0.06;filter:blur(0.5px);will-change:transform;animation:hex-float-2 22s -3s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.06)" stroke-width="1" />
      </svg>

      <!-- Hexagon 3 -->
      <svg
        class="absolute w-[64px]"
        style="top:55%;left:12%;opacity:0.09;will-change:transform;animation:hex-float-3 15s -7s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.09)" stroke-width="0.75" />
      </svg>

      <!-- Hexagon 4 -->
      <svg
        class="absolute hidden md:block w-[200px]"
        style="top:60%;left:82%;opacity:0.05;filter:blur(2px);will-change:transform;animation:hex-float-4 25s -5s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.05)" stroke-width="1.5" />
      </svg>

      <!-- Hexagon 5 -->
      <svg
        class="absolute hidden md:block w-[96px]"
        style="top:5%;left:62%;opacity:0.05;filter:blur(1px);will-change:transform;animation:hex-float-5 20s -10s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.05)" stroke-width="0.75" />
      </svg>

      <!-- Hexagon 6 -->
      <svg
        class="absolute w-[48px]"
        style="top:78%;left:20%;opacity:0.08;will-change:transform;animation:hex-float-6 16s -2s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.08)" stroke-width="0.5" />
      </svg>

      <!-- Hexagon 7 -->
      <svg
        class="absolute hidden md:block w-[40px]"
        style="top:25%;left:92%;opacity:0.06;filter:blur(0.5px);will-change:transform;animation:hex-float-7 19s -8s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 0 L93.3 25 L93.3 75 L50 100 L6.7 75 L6.7 25 Z" stroke="rgba(0,230,197,0.06)" stroke-width="0.5" />
      </svg>

      <!-- Shield -->
      <svg
        class="absolute w-[200px] md:w-[280px]"
        style="top:20%;left:50%;transform:translateX(-50%);opacity:0.03;filter:blur(3px);will-change:opacity;animation:shield-pulse 8s ease-in-out infinite"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M50 5 L10 22 V50 C10 76 28 94 50 100 C72 94 90 76 90 50 V22 Z" stroke="rgba(0,230,197,0.03)" stroke-width="1" />
      </svg>

      <!-- Keyhole -->
      <svg
        class="absolute w-[24px]"
        style="top:52%;left:50%;transform:translateX(-50%);opacity:0.08;filter:blur(1px);will-change:transform,opacity;animation:keyhole-glow 6s -2s ease-in-out infinite"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle cx="50" cy="50" r="12" stroke="rgba(0,230,197,0.08)" stroke-width="1" />
      </svg>

      <!-- Shackle -->
      <svg
        class="absolute hidden md:block w-[60px]"
        style="top:38%;left:50%;transform:translateX(-50%);opacity:0.05;filter:blur(1.5px);will-change:transform;animation:shackle-float 7s -1s ease-in-out infinite alternate"
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M30 55 V40 C30 18 70 18 70 40 V55" stroke="rgba(0,230,197,0.05)" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </div>
  </div>


  <!-- Badge -->
  <div class="hero-fade-in relative z-10 mb-8">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-border px-4 py-1 font-mono text-xs uppercase tracking-wider text-text-muted"
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      Open Source
    </span>
  </div>

  <!-- Headline -->
  <h1
    class="hero-fade-in [animation-delay:100ms] relative z-10 mx-auto max-w-[800px] text-5xl font-bold tracking-tight text-text md:text-7xl"
  >
    Keys stay where they belong.
    <br />
    <span class="text-accent">In the vault.</span>
  </h1>

  <!-- Subheadline -->
  <p
    class="hero-fade-in [animation-delay:200ms] relative z-10 mx-auto mt-6 max-w-2xl text-lg text-text-muted md:text-xl"
  >
    Browser-based authentication for Hive blockchain. Private keys never leave
    the WebWorker — encrypted, isolated, secure.
  </p>

  <!-- CTA: Install command -->
  <div
    class="hero-fade-in [animation-delay:300ms] relative z-10 mt-10"
  >
    <div
      class="flex items-center gap-2 rounded-lg border border-border bg-bg-card px-4 py-3"
    >
      <code id="install-cmd" class="font-mono text-sm text-accent select-all">
        npm install @hiveio/hb-auth
      </code>
      <button
        data-copy-button="install-cmd"
        type="button"
        class="group ml-1 cursor-pointer rounded-md p-1.5 text-text-muted transition-colors hover:bg-border hover:text-text"
        aria-label="Copy install command"
      >
        <!-- Clipboard icon (default) -->
        <svg
          class="h-4 w-4 transition-opacity duration-200 group-data-[copied]:hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9.75a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184"
          ></path>
        </svg>
        <!-- Checkmark icon (after copy) -->
        <svg
          class="hidden h-4 w-4 text-accent group-data-[copied]:block"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m4.5 12.75 6 6 9-13.5"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade-in {
    opacity: 0;
    animation: hero-fade-in 0.6s ease-out forwards;
  }

  /* Animated background keyframes */
  @keyframes hex-float-1 {
    from { transform: rotate(15deg) translateY(0); }
    to { transform: rotate(15deg) translateY(-20px); }
  }
  @keyframes hex-float-2 {
    from { transform: rotate(-10deg) translate(0, 0); }
    to { transform: rotate(-10deg) translate(8px, -15px); }
  }
  @keyframes hex-float-3 {
    from { transform: rotate(30deg) translateY(0); }
    to { transform: rotate(30deg) translateY(-12px); }
  }
  @keyframes hex-float-4 {
    from { transform: rotate(-20deg) translateY(0); }
    to { transform: rotate(-15deg) translateY(-25px); }
  }
  @keyframes hex-float-5 {
    from { transform: rotate(5deg) translate(0, 0); }
    to { transform: rotate(5deg) translate(-10px, -18px); }
  }
  @keyframes hex-float-6 {
    from { transform: rotate(45deg) translateY(0); }
    to { transform: rotate(45deg) translateY(-10px); }
  }
  @keyframes hex-float-7 {
    from { transform: rotate(-35deg) translateY(0); }
    to { transform: rotate(-30deg) translateY(-14px); }
  }
  @keyframes shield-pulse {
    0%, 100% { opacity: 0.03; }
    50% { opacity: 0.06; }
  }
  @keyframes keyhole-glow {
    0%, 100% { opacity: 0.08; transform: translateX(-50%) scale(1); }
    50% { opacity: 0.15; transform: translateX(-50%) scale(1.1); }
  }
  @keyframes shackle-float {
    from { transform: translateX(-50%) translateY(-3px); }
    to { transform: translateX(-50%) translateY(3px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-animated-bg svg {
      animation: none !important;
    }
  }
</style>

<script>
  import '../islands/CopyButton.ts';
</script>

---
// Navbar — sticky navigation with mobile hamburger menu
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg-nav backdrop-blur-md"
>
  <div class="mx-auto flex max-w-[75rem] items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="font-mono text-xl font-bold text-accent">HB-Auth</a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      <li>
        <a
          href="#features"
          class="text-sm text-text-muted transition-colors duration-200 hover:text-text"
        >
          Features
        </a>
      </li>
      <li>
        <a
          href="#how-it-works"
          class="text-sm text-text-muted transition-colors duration-200 hover:text-text"
        >
          How It Works
        </a>
      </li>
      <li>
        <a
          href="#architecture"
          class="text-sm text-text-muted transition-colors duration-200 hover:text-text"
        >
          Architecture
        </a>
      </li>
    </ul>

    <!-- Desktop icons -->
    <div class="hidden items-center gap-3 md:flex">
      <a
        href="https://gitlab.syncad.com/hive/hb-auth"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent transition-opacity duration-200 hover:opacity-70"
        aria-label="GitLab repository"
      >
        <svg width="28" height="28" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 30.4L21.3 14.1H10.7L16 30.4Z"/><path d="M16 30.4L10.7 14.1H2.4L16 30.4Z" opacity="0.7"/><path d="M2.4 14.1L0.5 20.1C0.3 20.7 0.5 21.4 1 21.8L16 30.4L2.4 14.1Z" opacity="0.5"/><path d="M2.4 14.1H10.7L7.4 3.9C7.2 3.3 6.4 3.3 6.2 3.9L2.4 14.1Z"/><path d="M16 30.4L21.3 14.1H29.6L16 30.4Z" opacity="0.7"/><path d="M29.6 14.1L31.5 20.1C31.7 20.7 31.5 21.4 31 21.8L16 30.4L29.6 14.1Z" opacity="0.5"/><path d="M29.6 14.1H21.3L24.6 3.9C24.8 3.3 25.6 3.3 25.8 3.9L29.6 14.1Z"/></svg>
      </a>
      <a
        href="https://www.npmjs.com/package/@hiveio/hb-auth"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent transition-opacity duration-200 hover:opacity-70"
        aria-label="npm package"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.664H5.334v-4H3.999v4H1.335V8.667h5.331v5.331zm4 0v1.336H8.001V8.667h5.334v5.331h-2.669zm12-.002h-1.33v-4h-1.336v4h-1.335v-4h-1.33v4h-2.671V8.667h8.002v5.329z" />
        </svg>
      </a>
    </div>

    <!-- Mobile hamburger button -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-text-muted transition-colors duration-200 hover:text-text md:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
    >
      <!-- Hamburger icon (shown when menu is closed) -->
      <svg
        id="nav-icon-open"
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <!-- Close icon (shown when menu is open) -->
      <svg
        id="nav-icon-close"
        class="hidden"
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="nav-mobile-menu"
    class="hidden border-t border-border md:hidden"
  >
    <ul class="mx-auto flex max-w-[75rem] flex-col gap-1 px-6 py-4">
      <li>
        <a
          href="#features"
          class="nav-mobile-link block rounded-lg px-4 py-3 text-sm text-text-muted transition-colors duration-200 hover:bg-bg-card hover:text-text"
        >
          Features
        </a>
      </li>
      <li>
        <a
          href="#how-it-works"
          class="nav-mobile-link block rounded-lg px-4 py-3 text-sm text-text-muted transition-colors duration-200 hover:bg-bg-card hover:text-text"
        >
          How It Works
        </a>
      </li>
      <li>
        <a
          href="#architecture"
          class="nav-mobile-link block rounded-lg px-4 py-3 text-sm text-text-muted transition-colors duration-200 hover:bg-bg-card hover:text-text"
        >
          Architecture
        </a>
      </li>
      <li class="flex items-center gap-3 px-4 pt-3">
        <a
          href="https://gitlab.syncad.com/hive/hb-auth"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-mobile-link text-accent transition-opacity duration-200 hover:opacity-70"
          aria-label="GitLab repository"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51a.42.42 0 0 1 .82 0l2.44 7.51h8.06l2.44-7.51a.42.42 0 0 1 .82 0l2.44 7.51 1.22 3.78a.84.84 0 0 1-.3.94z" />
          </svg>
        </a>
        <a
          href="https://www.npmjs.com/package/@hiveio/hb-auth"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-mobile-link text-accent transition-opacity duration-200 hover:opacity-70"
          aria-label="npm package"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.664H5.334v-4H3.999v4H1.335V8.667h5.331v5.331zm4 0v1.336H8.001V8.667h5.334v5.331h-2.669zm12-.002h-1.33v-4h-1.336v4h-1.335v-4h-1.33v4h-2.671V8.667h8.002v5.329z" />
          </svg>
        </a>
      </li>
    </ul>
  </div>
</nav>

<!-- Spacer to offset fixed navbar height -->
<div class="h-[4.5rem]"></div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile-menu');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');
  const mobileLinks = document.querySelectorAll('.nav-mobile-link');

  function closeMenu() {
    menu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');

    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    }
  });

  // Close mobile menu when a link is clicked
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  // Close mobile menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      closeMenu();
    }
  });
</script>

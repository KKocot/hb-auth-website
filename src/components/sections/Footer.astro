---
// Footer — site footer with links grid
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-[75rem] px-6 py-16">
    <!-- Grid: 3 columns on desktop, stacked on mobile -->
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Col 1: Brand -->
      <div class="flex flex-col gap-4">
        <span class="font-mono text-xl font-bold text-accent">HB-Auth</span>
        <p class="text-sm leading-relaxed text-text-muted">
          Secure blockchain authentication library for browser-based applications.
        </p>
        <p class="text-sm text-text-muted">Built for Hive blockchain.</p>
      </div>

      <!-- Col 2: Project Links -->
      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-text">Links</h3>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href="https://gitlab.syncad.com/hive/hb-auth"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors duration-200 hover:text-text"
            >
              GitLab Repository
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.npmjs.com/package/@hiveio/hb-auth"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors duration-200 hover:text-text"
            >
              npm Package
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://gitlab.syncad.com/hive/hb-auth/-/wikis/home"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors duration-200 hover:text-text"
            >
              Documentation
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Hive Ecosystem -->
      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-text">
          Hive Ecosystem
        </h3>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href="https://hive.io"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors duration-200 hover:text-text"
            >
              hive.io
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href="https://developers.hive.io"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors duration-200 hover:text-text"
            >
              developers.hive.io
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17L17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 border-t border-border pt-8">
      <p class="text-center text-sm text-text-muted">
        &copy; {currentYear} Hive. Open Source under MIT License.
      </p>
    </div>
  </div>
</footer>

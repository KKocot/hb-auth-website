---

<footer class="tmux-status" role="contentinfo">
  <div class="tmux-status__bar">
    <span class="tmux-status__segment"
      ><a
        href="https://gitlab.syncad.com/hive/hb-auth"
        class="tmux-status__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="hb-auth — source on GitLab"
        >[hb-auth]</a
      ></span
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://gitlab.syncad.com/hive/hb-auth/-/blob/develop/LICENSE"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="MIT License — opens in new tab"
      >MIT License</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://hive.io"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="Hive blockchain ecosystem — opens in new tab"
      >Hive</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://www.npmjs.com/package/@hiveio/hb-auth"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="hb-auth on npm — opens in new tab"
      >npm</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://blockchainwares.com.pl/"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="Blockchain Wares — opens in new tab"
      >Blockchain Wares</a
    ><span class="tmux-status__sep" aria-hidden="true">│</span><a
      href="https://tools.openhive.network"
      target="_blank"
      rel="noopener noreferrer"
      class="tmux-status__link"
      aria-label="Hive Tools — opens in new tab"
      >Hive Tools</a
    >
  </div>
</footer>

<style>
  .tmux-status {
    background-color: var(--color-bg-surface);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    line-height: 1;
    transition:
      background-color var(--mode-transition, 300ms) ease,
      border-color var(--mode-transition, 300ms) ease;
  }

  .tmux-status__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: var(--space-2) var(--space-4);
    min-height: 2rem;
  }

  .tmux-status__segment {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .tmux-status__sep {
    color: var(--color-text-subtle);
    padding-inline: var(--space-2);
    user-select: none;
  }

  .tmux-status__link {
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-shadow var(--duration-fast) var(--ease-out);
  }

  .tmux-status__link:hover,
  .tmux-status__link:focus-visible {
    color: var(--color-primary-bright);
    text-shadow: var(--glow-intensity) var(--glow-color);
  }

  .tmux-status__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }

  @media (max-width: 40rem) {
    .tmux-status__bar {
      padding: var(--space-2) var(--space-3);
      gap: 0.25rem 0;
      justify-content: center;
    }
  }
</style>
